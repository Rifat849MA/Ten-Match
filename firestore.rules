rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'bestScore', 'isGuest', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 24
        && request.resource.data.bestScore is int
        && request.resource.data.bestScore >= 0
        && request.resource.data.isGuest is bool
        && request.resource.data.isGuest == (request.auth.token.firebase.sign_in_provider == 'anonymous');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
